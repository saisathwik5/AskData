# Database (Supavisor Transaction Pooler on port 6543)
SUPABASE_DB_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Model Selection: 1st preference is "gemini", 2nd preference is "openai"
MODEL_PROVIDER="gemini"
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_API_KEY="AIzaSy..."

# Secondary Provider (OpenAI / ChatGPT)
OPENAI_MODEL="gpt-4o-mini"
OPENAI_API_KEY="sk-proj-..."

# Tertiary Provider (Anthropic)
ANTHROPIC_API_KEY=""

# Java Query Guard Service (AST Security Proxy)
GUARD_SERVICE_URL="http://localhost:8081"
